{
  "name": "tontie-re",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy:yandex": "bash scripts/deploy-yandex-storage.sh",
    "preview": "vite preview",
    "format": "prettier --write src tests package.json",
    "format:check": "prettier --check src tests package.json",
    "lint": "npm run format:check && eslint . --max-warnings 0",
    "sync:swf": "cp reference/tontie.swf public/game/tontie.swf",
    "build:catalog": "node scripts/build-enemy-catalog.mjs",
    "export:assets": "node scripts/export-game-assets.mjs",
    "mesh:mobs": "scripts/mesh-pipeline/.venv/bin/python scripts/mesh-pipeline/sprite_to_glb.py",
    "mesh:blender": "blender --background --python scripts/blender/batch_export.py",
    "build:manifest": "node scripts/build-reconstruction-manifest.mjs",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "sonar": "sh -c 'set -a; [ -f .env ] && . ./.env; set +a; npm run test:coverage && npx sonar-scanner -Dsonar.host.url=${SONAR_HOST_URL:-http://localhost:9000} ${SONAR_TOKEN:+-Dsonar.token=$SONAR_TOKEN}'"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@ruffle-rs/ruffle": "^0.2.0",
    "i18next": "^26.5.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.1.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0"
  }
}
